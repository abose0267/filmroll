{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "../shared"],
  "exclude": ["../shared/**/*.test.ts"]
}
