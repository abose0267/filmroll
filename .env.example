# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These identify your project; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match REGION in functions/src/config.ts.
VITE_FUNCTIONS_REGION=us-central1

# Local development against the Firebase Emulator Suite (npm run emulators).
# When true the app talks to local emulators and no real Firebase config is needed.
VITE_USE_EMULATORS=true

# Optional: where developed photos are served from. Defaults to the `photo`
# Cloud Function URL. Set to /api/photo when hosting on Firebase Hosting
# (firebase.json rewrites it to the function on the same origin).
VITE_PHOTO_ENDPOINT=
