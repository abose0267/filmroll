{
  "name": "filmroll",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_USE_EMULATORS=true vite",
    "emulators": "firebase emulators:start --project demo-filmroll --import=.emulator-data --export-on-exit=.emulator-data",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-filmroll --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npm --prefix functions run build && firebase emulators:exec --project demo-filmroll --only auth,firestore,storage,functions \"tsx --tsconfig functions/tsconfig.json scripts/e2e.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "dev:phone": "FILMROLL_PHONE=1 VITE_USE_EMULATORS=true VITE_EMULATOR_PROXY=true vite"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "playwright-core": "^1.56.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
